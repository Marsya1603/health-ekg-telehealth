# ============================================================
# HealthEKG Telehealth - Contoh Konfigurasi Environment
# Salin file ini menjadi .env lalu sesuaikan nilai di server Anda.
#   cp .env.example .env && php artisan key:generate
# JANGAN menyimpan kredensial produksi di source code.
# ============================================================

APP_NAME="HealthEKG Telehealth"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------- Database MySQL ----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=healthekg
DB_USERNAME=healthekg
DB_PASSWORD=

# ---------------- Session & Cache ----------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=sync

# ---------------- Mail (opsional) ----------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="puskesmas@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------- HealthEKG ----------------
# Host broker MQTT hanya untuk CEK STATUS koneksi dari dashboard
# (username/password broker TIDAK disimpan di aplikasi web - hanya di worker)
HEALTHEKG_MQTT_HOST=127.0.0.1
HEALTHEKG_MQTT_PORT=1883
HEALTHEKG_MQTT_TOPIC_PREFIX=healthekg
HEALTHEKG_MQTT_QOS=1

# Status worker dianggap aktif jika heartbeat < N detik
HEALTHEKG_WORKER_TIMEOUT=120

# Perangkat dianggap "tidak mengirim data" jika pesan terakhir > N detik
HEALTHEKG_HEARTBEAT_TIMEOUT=300

# Interval pemeriksaan sesi yang berhenti mengirim data (menit)
HEALTHEKG_GAP_ALERT_MINUTES=10

# Apakah pasien boleh melihat grafik EKG miliknya (true/false)
HEALTHEKG_PATIENT_ECG_VISIBLE=true

# Izinkan ekspor CSV laporan/log (true/false)
HEALTHEKG_EXPORTS_ENABLED=true

# Wajib ganti password setelah login pertama / reset password (true/false)
HEALTHEKG_FORCE_PASSWORD_CHANGE=true
